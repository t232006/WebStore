<h3>Our employees</h3>
<table class="conteiner">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Position</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td><a href="/Home/EmployeeDetails/@employee.Id">@employee.Name</a></td>
                <td>@employee.Position</td>
                <td>@employee.Age</td>
            </tr>
        }
    </tbody>
</table>
<a href="/">На главную</a>

