@model IEnumerable<BrandsViewModel>
<div class="brands_products">
    <!--brands_products-->
    <h2>Brands</h2>
    <div class="brands-name">
        <ul class="nav nav-pills nav-stacked">
            @foreach(var br in Model)
            {
               <li><a asp-controller="Catalog" asp-action="Index" asp-route-BrandID="@br.ID"> <span class="pull-right">(50)</span>@br.Name</a></li>  
            }
        </ul>
    </div>
</div><!--/brands_products-->
