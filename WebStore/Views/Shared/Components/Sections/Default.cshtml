@model IEnumerable<SectionsViewModel>
<div class="panel-group category-products" id="accordian">
    <!--category-productsr-->
    @foreach (var parents in Model)
    {
        @if (parents.ChildSection.Count > 0)
        {
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">
                    <a data-toggle="collapse" data-parent="#accordian" href="#@parents.GetHashCode()">
                        <span class="badge pull-right"><i class="fa fa-plus"></i></span>
                        @parents.Name
                    </a>
                </h4>
            </div>
            <div id="@parents.GetHashCode()" class="panel-collapse collapse">
                <div class="panel-body">
                    <ul>
                            @foreach (var childs in parents.ChildSection)
                            {
                                <li><a href="#">@childs.Name</a></li>
                            }
                    </ul>
                </div>
            </div>
        </div> 
        }
        else
        {
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title"><a href="#">@parents.Name</a></h4> 
            </div>
        </div>  
        }
    }
    
  
   
</div><!--/category-products-->
