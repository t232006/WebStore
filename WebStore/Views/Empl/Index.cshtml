@model IEnumerable<WebStore.Domain.Base.Employee>
<div class="container">
<h3>Our employees</h3>
@if (@Model.Any())
{
    <p>
        <a asp-action="Edit" class="btn btn-default">Insert throught Edit</a>
        <a asp-action="InsertEmp" class="btn btn-default">Insert throught Create</a>

    </p>
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>ID</th>
                <th>Name</th>
                <th>Position</th>
                <th>Age</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                    <form asp-action="DeleteConfirmed" asp-route-id="@employee.ID">
                        <input type="submit" value="X" class="btn btn-danger"/>

                    </form>
                    </td>
                    <td>@employee.ID</td>
                    <td><a asp-controller="Empl" asp-action="Details" asp-route-ID="@employee.ID">@employee.Name</a></td>
                    <td>@employee.Position</td>
                    <td>@employee.Age</td>
                    <td>
                        <a asp-action="Edit" asp-route-ID="@employee.ID"
                           class="btn-sm btn-default">
                            <i class="fa fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-ID="@employee.ID"
                           class="btn-sm btn-danger">
                            <i class="fa fa-trash-o"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
    else{<p>There are no records</p>}

    
<a href="/">На главную</a>
</div>

