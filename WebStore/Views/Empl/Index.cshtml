@model IEnumerable<WebStore.Models.Employee>
<div class="container">
<h3>Our employees</h3>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Position</th>
            <th>Age</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td><a asp-controller="Empl" asp-action="Details" asp-route-Id="@employee.Id" >@employee.Name</a></td>
                <td>@employee.Position</td>
                <td>@employee.Age</td>
                <td>
                    <a asp-action="Edit" asp-route-Id="@employee.Id"
                        class="btn btn-default" >
                        <i class="fa fa-edit"></i>
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>
<a href="/">На главную</a>
</div>

