 @model RegisterUserViewModel

<section id="form">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-4 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Регистрация нового пользователя</h2>
					<form asp-action="Register" asp-antiforgery="true">
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>
						
						<input asp-for="user_Name" placeholder="User Name" />

						<input asp-for="Email" placeholder="Email" />
						<span asp-validation-for="Email" class="alert-danger" ></span>
						<input type="text" asp-for="UserName" placeholder="Login" />
						<span asp-validation-for="UserName" class="alert-danger"></span>
						<input asp-for="password" placeholder="Password" />
						<span asp-validation-for="password" class="alert-danger" ></span>
						<input asp-for="passwordConfirmation" placeholder="Repeat password"/>
						<span asp-validation-for="passwordConfirmation" class="alert-danger" ></span>
						
						<button type="submit" class="btn btn-default">Registration</button>
					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->